# Copy to .env, fill in these three, then run `npm run setup`.
# Setup creates the Auth0 app/API and adds AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET
# and AUTH0_AUDIENCE to this file for you.

# Your Auth0 tenant domain (or custom domain)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Machine-to-Machine app authorized for the Auth0 Management API (used only by setup)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
